DATABASE_URL="file:./dev.db" # Or postgresql://user:pass@host:5432/db
JWT_SECRET="your-super-secret-jwt-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_OVERDUE_DAYS="3"

# --- Email Notifications Configuration (Optional: choose either SMTP/Gmail or Resend) ---
# Option A: Gmail SMTP (Use a 16-character App Password from Google Account > Security)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="SocietyCare <your-email@gmail.com>"

# Option B: Resend API
# RESEND_API_KEY="re_123456789"
